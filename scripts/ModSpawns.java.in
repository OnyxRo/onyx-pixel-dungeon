/*
 * Onyx's Pixel Dungeon
 * GENERATED by scripts/mod-spawns.py from each mod's own spawn table, do not edit by hand. Change the script and rerun it.
 *
 * The monsters a floor of a mod's world spawns, as that mod spawned them on the same floor of its own dungeon.
 * Most tables are a rotation, like Shattered's MobSpawner. Older mods rolled each monster by chance, those
 * tables are kept as chances. Floors are this game's, already lined up with the mod's own regions.
 */
package com.shatteredpixel.shatteredpixeldungeon.actors.mobs;

import com.watabou.utils.Random;

import java.util.ArrayList;
import java.util.HashMap;

public class ModSpawns {

	private static class Table {
		boolean chance;
		String[] names;
		float[] weights;
	}

	private static final HashMap<String, Table> TABLES = new HashMap<>();

	private static final String PKG = "com.shatteredpixel.shatteredpixeldungeon.";

	//names and weights in pairs. A name ending in .random is picked with that class's random(), like Shaman
	private static void put( String key, int depth, boolean chance, Object... pairs ){
		Table t = new Table();
		t.chance = chance;
		t.names = new String[pairs.length / 2];
		t.weights = new float[pairs.length / 2];
		for (int i = 0; i < t.names.length; i++) {
			t.names[i] = (String) pairs[2 * i];
			t.weights[i] = (Float) pairs[2 * i + 1];
		}
		TABLES.put( key + "@" + depth, t );
	}

	static {
		//TABLES
	}

	//METHODS

	/** True when a mod (or a level class) has a table for this floor. */
	public static boolean has( String key, int depth ){
		return key != null && TABLES.containsKey( key + "@" + depth );
	}

	/**
	 * The rotation for a floor, or null if there is no table or none of its monsters could be made.
	 * Chance tables give ten rolls, the level asks again when they run out.
	 */
	public static ArrayList<Class<? extends Mob>> rotation( String key, int depth ){
		Table t = key == null ? null : TABLES.get( key + "@" + depth );
		if (t == null) return null;
		ArrayList<Class<? extends Mob>> mobs = new ArrayList<>();
		if (t.chance) {
			for (int i = 0; i < 10; i++) {
				Class<? extends Mob> c = find( t.names[Random.chances( t.weights )] );
				if (c != null) mobs.add( c );
			}
		} else {
			for (String n : t.names) {
				Class<? extends Mob> c = find( n );
				if (c != null) mobs.add( c );
			}
		}
		if (mobs.isEmpty()) return null;
		Random.shuffle( mobs );
		return mobs;
	}

	@SuppressWarnings("unchecked")
	private static Class<? extends Mob> find( String name ){
		try {
			if (name.endsWith( ".random" )) {
				Class<?> c = Class.forName( PKG + name.substring( 0, name.length() - 7 ) );
				return (Class<? extends Mob>) c.getMethod( "random" ).invoke( null );
			}
			return (Class<? extends Mob>) Class.forName( PKG + name );
		} catch (Throwable t) {
			return null;
		}
	}

	/** Every class named in the tables, for the headless test. */
	public static ArrayList<String> allNames(){
		ArrayList<String> out = new ArrayList<>();
		for (Table t : TABLES.values()) for (String n : t.names) if (!out.contains( n )) out.add( n );
		return out;
	}

	public static boolean resolves( String name ){
		return find( name ) != null;
	}
}
